    static class Sell
    {
        int money;
        String[] inventory;
        int count;

        Sell(int money)
        {
            this.money = money;
            this.inventory = new String[100];
            this.count = 0;
        }

        // heheahaha, I'm evil hahahaha
        int priceOf(String fruit)
        {
            if(fruit.equals("rocket"))           return 2;
            else if(fruit.equals("ice"))         return 5;
            else if(fruit.equals("magma"))       return 10;
            else if(fruit.equals("buddha"))      return 20;
            else if(fruit.equals("magnet"))      return 45;
            else if(fruit.equals("kitsune"))     return 50;
            else if(fruit.equals("dragon east")) return 75;
            else if(fruit.equals("dragon west")) return 75;
            else                                 return 0;
        }

        int countOf(String fruit)
        {
            int total = 0;
            for(int i = 0; i < count; i++)
            {
                if(inventory[i].equals(fruit)) total++;
            }
            return total;
        }

        // dont blame me if something happens and U dont get to sell or store...
        void sell(String fruit)
        {
            System.out.print("would you like to sell your fruit?, y/n : ");
            String opt = sc.nextLine().trim().toLowerCase();

            if(opt.equals("y"))
            {
                int price = priceOf(fruit);
                money += price;
                System.out.println("sold for $" + price + ", you now have $" + money);
            }
            else if(opt.equals("n"))
            {
                System.out.println("cool, live good bro 😎");
                System.out.print("would you like to store the fruit U rolled?, y/n : ");
                String optStore = sc.nextLine().trim().toLowerCase();

                if(optStore.equals("n"))
                {
                    System.out.println("k,cya!");
                }
                else if(optStore.equals("y"))
                {
                    if(count < inventory.length)
                    {
                        inventory[count] = fruit;
                        count++;
                        System.out.println("cool!");
                    }
                    else
                    {
                        System.out.println("yo, your inventory is full");
                    }
                }
                else
                {
                    System.out.println("why?");
                }
            }
        }

        void showInventory()
        {
            System.out.println("\n--- inventory ---"); // 😎
            System.out.println("money: $" + money);

            if(count == 0)
            {
                System.out.println("what U trying?, U dont have any stored fruits yet..😭🤣");
                return;
            }

            for(String type : TYPES)
            {
                int amount = countOf(type);
                if(amount == 0) continue;
                System.out.println(type + " x" + amount);
            }
            System.out.println("total stored: " + count + "/" + inventory.length);
        }

        void unstore()
        {
            if(count == 0)
            {
                System.out.println("U have nothing stored!");
                return;
            }

            showInventory();
            System.out.print("which fruit do you want to unstore? : ");
            String fruit = sc.nextLine().trim().toLowerCase();

            int have = countOf(fruit);
            if(have == 0)
            {
                System.out.println("U dont have any " + fruit + " fruit stored.");
                return;
            }

            System.out.print("how many? (1 to " + have + ") : ");
            int amount;
            try
            {
                amount = Integer.parseInt(sc.nextLine().trim());
            }
            catch(NumberFormatException e)
            {
                System.out.println("that is not a number!🥲, bruh why U like this?");
                return;
            }

            if(amount < 1 || amount > have)
            {
                System.out.println("U can only unstore between 1 and " + have);
                return;
            }

            // dear program, please work
            int write = 0;
            int removed = 0;
            for(int read = 0; read < count; read++)
            {
                if(inventory[read].equals(fruit) && removed < amount)
                {
                    removed++;
                }
                else
                {
                    inventory[write] = inventory[read];
                    write++;
                }
            }
            for(int i = write; i < count; i++)
            {
                inventory[i] = null;
            }
            count = write;

            System.out.println("unstored " + amount + " " + fruit + " fruit(s), enjoy bruh..");

            System.out.print("do you want to sell them?, y/n : ");
            String opt = sc.nextLine().trim().toLowerCase();
            if(opt.equals("y"))
            {
                int total = priceOf(fruit) * amount;
                money += total;
                System.out.println("sold for $" + total + ", you now have $" + money);
            }
            else
            {
                System.out.println("ok, they are yours now!"); // imagen learning java and remake this rolling system, just to realise ai is becomming powerful.., lil me
            }
        }
    }
